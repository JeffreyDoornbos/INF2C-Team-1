upstream cargohub_v2 {
    server api-__ACTIVE_SLOT__:8080;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name 145.24.237.22 localhost;
    # Python's existing API_KEY header contains an underscore and must be forwarded.
    underscores_in_headers on;
    client_max_body_size 5m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Administration is served only over HTTPS; the short-lived IP certificate
    # uses an HTTP-01 challenge on the isolated dashboard listener.
    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://host.docker.internal:8765;
    }
    location = /beheer { return 302 https://145.24.237.22/beheer/; }
    location /beheer/ { return 302 https://145.24.237.22$request_uri; }

    location = / { return 302 /api/v2; }
    location = /swagger { return 302 /api/v2/swagger/index.html; }
    location = /swagger/ { return 302 /api/v2/swagger/index.html; }
    location = /api/v2 { proxy_pass http://cargohub_v2; }
    location /api/v2/ { proxy_pass http://cargohub_v2; }
    location = /health/ready { proxy_pass http://cargohub_v2; }

    # The original Python process continues on the host's existing port 8400.
    location = /api/v1 { proxy_pass http://host.docker.internal:8400; }
    location /api/v1/ { proxy_pass http://host.docker.internal:8400; }
    location / { return 404; }
}
