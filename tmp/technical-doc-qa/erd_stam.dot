digraph G {graph [bgcolor="transparent", fontname="Arial", ranksep=0.55, nodesep=0.35, pad=0.15]; node [shape=record, style="rounded,filled", fillcolor="#f3f5f8", color="#aab5c5", fontname="Arial", fontsize=16, margin="0.16,0.12"]; edge [fontname="Arial", fontsize=12, color="#66758a", arrowsize=0.65];warehouse [label="{warehouse|PK id\lname, code\l}",fillcolor="#f3f5f8"];location [label="{location|PK id\lFK warehouse_id\lcode, name\l}",fillcolor="#f3f5f8"];supplier [label="{supplier|PK id\lname, contact_name\l}",fillcolor="#f3f5f8"];item_group [label="{item_group|PK id\lname, description\l}",fillcolor="#f3f5f8"];item_line [label="{item_line|PK id\lname, description\l}",fillcolor="#f3f5f8"];item_type [label="{item_type|PK id\lname, description\l}",fillcolor="#f3f5f8"];item [label="{item|PK id\lFK supplier_id\lFK item_group_id\lFK item_line_id\lFK item_type_id\lcode, unit_weight\l}",fillcolor="#f3f5f8"];inventory [label="{inventory|PK FK item_id\lPK FK location_id\lquantity_on_hand\lquantity_allocated\lquantity_expected\lquantity_ordered\l}",fillcolor="#f3f5f8"];warehouse -> location [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];location -> inventory [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];item -> inventory [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];supplier -> item [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];item_group -> item [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];item_line -> item [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];item_type -> item [dir=both, arrowtail=tee, arrowhead="crowodot", taillabel="1",headlabel="0..*",label="",labeldistance=1.8];}